# انسخ هذا الملف إلى backup.env ثم chmod 600 backup.env
# رابط الاتصال المباشر أو Session pooler (المنفذ 5432) من: Supabase > Project Settings > Database
# لا تستعمل Transaction pooler (6543) مع pg_dump.
SUPABASE_DB_URL='postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres'
BACKUP_DIR="$HOME/anwar-backups"
KEEP_DAILY=14        # عدد النسخ اليومية المحفوظة
KEEP_WEEKLY=8        # عدد النسخ الأسبوعية (الأحد)
# اختياري: رابط نبض (Healthchecks.io أو مشابه) يُستدعى عند النجاح فقط ليُنبّهك إن توقفت النسخ
HEARTBEAT_URL=''
